# ---- Core ----
NODE_ENV=development
PORT=5000
# MongoDB Atlas connection string (use a dedicated DB user with readWrite on one database)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/famevote?retryWrites=true&w=majority
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-64-hex-chars-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_JWT_SECRET=replace-with-a-different-64-hex-chars-xxxxxxxxxxxxxxxxxxxxxxxx
RECEIPT_HMAC_SECRET=replace-with-another-64-hex-chars-xxxxxxxxxxxxxxxxxxxxxxxxx

# ---- URLs ----
# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
# Leave empty unless you serve both apps from sibling subdomains
COOKIE_DOMAIN=

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Razorpay (use rzp_test_ keys until you have verified everything) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Gemini ----
GEMINI_API_KEY=
# Pick a model that is currently available on the free tier in Google AI Studio; check quotas before deploying.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=15000

# ---- Email: Brevo REST API (https://app.brevo.com > SMTP & API > API keys) ----
# EMAIL_FROM_EMAIL must be a verified sender or domain in Brevo. Without BREVO_API_KEY, links are printed to the console in development only.
BREVO_API_KEY=
EMAIL_FROM_EMAIL=no-reply@your-domain.com
EMAIL_FROM_NAME=FameVote

# ---- Google Sign-In (Google Cloud Console > APIs & Services > Credentials > OAuth client ID > Web application) ----
# Add your client URL(s) under "Authorized JavaScript origins". The same ID goes in client VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# ---- Celebrity portraits (optional; used only by `npm run images:fetch`) ----
# Free key from themoviedb.org (Settings > API). Without it the pipeline uses Wikipedia and Wikimedia Commons only.
TMDB_API_KEY=

# ---- Phone (OTP) sign-in ----
# none = hidden (default) | twilio | msg91 | console (development only: prints the code in the server log; refused in production)
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ---- Campaign rules ----
CAMPAIGN_TIMEZONE=Asia/Kolkata
CAMPAIGN_CUTOFF_TIME=23:59:59
# Minutes after closing before results may be finalized (lets in-flight payments settle)
FINALIZE_GRACE_MINUTES=30
# Auto-finalize this many hours after closing (0 = admin finalizes manually)
AUTO_FINALIZE_AFTER_HOURS=1
# Publish winners automatically when the scheduler finalizes a month (results day)
AUTO_PUBLISH_RESULTS=true
AUTO_REFUND=true
ENABLE_SCHEDULER=true

# ---- Seed (only used by `npm run seed`) ----
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
