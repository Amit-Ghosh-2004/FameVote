# Backend API base URL. Leave EMPTY in local development: the Vite dev server proxies /api to http://localhost:5000,
# which keeps cookies same-origin. In production set it to your Render URL (https://<service>.onrender.com).
VITE_API_URL=

# Your public site URL (https, no trailing slash). Used for link previews (og:image) and the canonical tag. Production builds only.
VITE_SITE_URL=

# Google Sign-In web client ID (same value as the server GOOGLE_CLIENT_ID). Leave empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=
